FROM python:3.11-slim

WORKDIR /app

# System deps — curl for healthcheck, build-essential for native packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python deps first (better layer caching)
COPY backend/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Download spaCy NER model for PII detection (small model, ~12MB)
RUN python -m spacy download en_core_web_sm || echo "spaCy model download failed — NER PII detection will be disabled"

# Copy backend source
COPY backend/ ./backend/

# Create data directories
RUN mkdir -p /app/chromadb_data /app/data

# Non-root user for security
RUN useradd -m -u 1001 sentinel && chown -R sentinel:sentinel /app
USER sentinel

EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=5 \
  CMD curl -f http://localhost:8000/health || exit 1

CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
