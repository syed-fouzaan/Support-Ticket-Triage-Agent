# SentinelDesk — Environment Variable Reference
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Options: gemini | groq | openrouter
LLM_PROVIDER=gemini

# Your API key for the chosen provider (required)
LLM_API_KEY=your_api_key_here

# Model to use (provider-specific model name)
# Gemini:      gemini-2.5-flash
# Groq:        llama-3.3-70b-versatile
# OpenRouter:  google/gemini-2.5-flash-preview
LLM_MODEL=gemini-2.5-flash

LLM_TIMEOUT_SECONDS=30
LLM_CIRCUIT_BREAKER_THRESHOLD=3

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default for local/demo):
DATABASE_URL=sqlite+aiosqlite:///./sentineldesk.db
# PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/sentineldesk

# ── ChromaDB ──────────────────────────────────────────────────────────────────
CHROMADB_PATH=./chromadb_data

# ── Auth & Security ───────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET=change_me_to_a_random_64_byte_hex_string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated origins. Use http://localhost:5173 for local Vite dev.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Rate Limiting ─────────────────────────────────────────────────────────────
# Options: free | standard | enterprise
RATE_LIMIT_TIER=free
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# ── Cost / Token Ceilings ─────────────────────────────────────────────────────
MAX_TOKENS_PER_TICKET=4096
MAX_DAILY_COST_USD=5.0

# ── Confidence Thresholds ─────────────────────────────────────────────────────
CONFIDENCE_THRESHOLD=0.75
AUTO_SEND_CONFIDENCE_THRESHOLD=0.95

# ── RAG Settings ──────────────────────────────────────────────────────────────
RAG_TOP_K=6
RAG_TOP_N=3
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=77
RAG_SIMILARITY_THRESHOLD=0.3

# ── SSRF Allow-list ───────────────────────────────────────────────────────────
# Comma-separated domains the system may fetch (leave empty if none needed)
SSRF_ALLOWED_DOMAINS=

# ── Webhook Security ──────────────────────────────────────────────────────────
# HMAC secret for email-connector webhook validation
WEBHOOK_SECRET=change_me_to_a_random_webhook_secret

# ── Misc ──────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
DUPLICATE_TICKET_SIMILARITY_THRESHOLD=0.85
